<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FluentCMS.Components.Browser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
  </ItemGroup>

  <!-- The gallery is a separate process, so it is built here but not referenced as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\..\gallery\Gallery\Gallery.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Where the build of the gallery ends up, for the fixture that starts it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GalleryOutput</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'gallery', 'Gallery', 'bin', '$(Configuration)', '$(TargetFramework)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
