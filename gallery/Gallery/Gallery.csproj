<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gallery</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The host runs on a server and is never trimmed or compiled ahead of time,
         and server-side Blazor does not support either. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gallery.Client\Gallery.Client.csproj" />
    <ProjectReference Include="..\..\src\FluentCMS.Components\FluentCMS.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
